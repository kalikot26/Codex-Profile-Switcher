# Build artifacts (root and any subfolder: gui/, kalikot-aisw/, kalikot-claude/)
target/
node_modules/
dist/
build/
dist-backup/

# Standalone executables ship via GitHub Releases, not in the repo
*.exe

# Development folders
/.code
/.sisyphus

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# PyInstaller spec files (regenerated by build.bat)
*.spec

# GUI runtime data / caches
/data
usage-cache.json
auth.json
auth.json.bak*

# Environment
.env
.env.*

# Coverage
*.profraw
*.profdata
coverage/
lcov.info

# CI workflows omitted (PAT lacks 'workflow' scope); add later via UI or a workflow-scoped token
.github/workflows/

# Non-aisw content — not part of this repo (kept locally, not published).
# This repo ships ONLY the KalikotAISW edition (kalikot-aisw/). The legacy
# codex-profiles-backed GUI is intentionally excluded. KaliClaude lives in its
# own repo. Anchored to root so kalikot-aisw/* is never matched.
/gui/
/src/
/tests/
/bin/
/scripts/
/docs/
/checksums/
/.config/
/kalikot-claude/
/Cargo.toml
/Cargo.lock
/Makefile
/install.sh
/package.json
/rust-toolchain.toml
/CHANGELOG.md
/CONTRIBUTING.md
/NOTIFIER_UPDATE_NOTES.md
/KALIKOT_SUMMARY.md
/app.ico
